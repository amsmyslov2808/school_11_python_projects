mn index="1" value="24"/><column index="2" value="182"/><column index="3" value="76"/><column index="4" value="80"/><column index="5" value="106"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT 
s.id, 
s.name AS subject_name, 
t.full_name AS teacher_name, 
t.experience AS teacher_experience, 
s.hours_per_week, 
s.is_mandatory 
FROM subjects AS s
JOIN teachers AS t ON s.teacher_id=t.id
WHERE s.hours_per_week&lt;=3 AND s.is_mandatory=0 AND t.experience&lt;=10
ORDER BY t.experience ASC
</sql><current_tab id="0"/></tab_sql></sqlb_project>
